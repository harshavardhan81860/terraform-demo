# environments/dev/security-group/terragrunt.hcl
include "root" {
  path = find_in_parent_folders()
}

terraform {
  source = "../../../modules/security-group"
}

# Declare the upstream network dependency requirement
dependency "vpc" {
  config_path = "../vpc"
}

# Pass the output value directly from the VPC module into this variable execution
inputs = {
  vpc_id = dependency.vpc.outputs.vpc_id
}
